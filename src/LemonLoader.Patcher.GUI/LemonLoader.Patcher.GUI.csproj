<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <ProjectReference Include="../LemonLoader.Patcher.Core/LemonLoader.Patcher.Core.csproj"
                      GlobalPropertiesToRemove="PublishSingleFile;SelfContained" />
    <None Include="../../.config/dotnet-tools.json" Link=".config/dotnet-tools.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
