<Project>
  <PropertyGroup>
    <Version>1.1.2</Version>
    <BundledIl2CppInteropRevision>260e13e4b55d2b20853c2175bfe9f9f7875692d8</BundledIl2CppInteropRevision>
    <BundledIl2CppInteropRepositoryUrl>https://github.com/LemonLoaderX/Il2CppInterop.git</BundledIl2CppInteropRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BundledIl2CppInteropRevision"
                      Value="$(BundledIl2CppInteropRevision)" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'LemonLoader.Patcher.Core'">
    <Using Include="LemonLoader.Patcher.Core" />
  </ItemGroup>
</Project>
